#!/usr/bin/env bash
# AWDL (Apple Wireless Direct Link) toggle for low-latency gaming
set -euo pipefail

# ANSI color codes (if running in terminal)
if [ -t 1 ]; then
  GREEN='\033[0;32m'
  YELLOW='\033[0;33m'
  RED='\033[0;31m'
  BOLD='\033[1m'
  NC='\033[0m'
else
  GREEN=''
  YELLOW=''
  RED=''
  BOLD=''
  NC=''
fi

usage() {
  local exit_code="${1:-1}"
  echo -e "${BOLD}Usage:${NC} awdl {on|off|status|toggle}"
  echo ""
  echo "Manage Apple Wireless Direct Link (AWDL) interface:"
  echo "  on, enable     Enable AWDL (restores AirDrop and AirPlay)"
  echo "  off, disable   Disable AWDL (low-latency Wi-Fi gaming mode)"
  echo "  status         Display current AWDL interface status"
  echo "  toggle         Toggle AWDL between active and inactive"
  exit "$exit_code"
}

if [ $# -lt 1 ]; then
  usage 1
fi

case "$1" in
  on|enable)
    sudo ifconfig awdl0 up
    echo -e "${GREEN}📡 AWDL enabled (AirDrop/AirPlay active)${NC}"
    ;;
  off|disable)
    sudo ifconfig awdl0 down
    echo -e "${YELLOW}🎮 AWDL disabled (Low-Latency Gaming Mode active)${NC}"
    ;;
  status)
    if ifconfig awdl0 2>/dev/null | grep -q "status: active"; then
      echo -e "${GREEN}📡 AWDL: Active (AirDrop ON)${NC}"
    else
      echo -e "${YELLOW}🎮 AWDL: Inactive (Gaming Mode ON)${NC}"
    fi
    ;;
  toggle)
    if ifconfig awdl0 2>/dev/null | grep -q "status: active"; then
      sudo ifconfig awdl0 down
      echo -e "${YELLOW}🎮 AWDL disabled (Gaming Mode ON)${NC}"
    else
      sudo ifconfig awdl0 up
      echo -e "${GREEN}📡 AWDL enabled (AirDrop ON)${NC}"
    fi
    ;;
  -h|--help|help)
    usage 0
    ;;
  *)
    echo -e "${RED}Error:${NC} Unknown command '$1'" >&2
    usage 1
    ;;
esac
